{
  "env": {
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_RESUME_INTERRUPTED_TURN": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "2000",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "64",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "64",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "WebSearch",
      "Bash(jq *)",
      "Bash(nl *)",
      "Bash(rg *)",
      "Bash(cut *)",
      "Bash(dir *)",
      "Bash(file *)",
      "Bash(mypy *)",
      "Bash(tree *)",
      "Bash(git tag)",
      "Bash(sh -n *)",
      "Bash(npm ls *)",
      "Bash(bash -n *)",
      "Bash(dirname *)",
      "Bash(git log *)",
      "Bash(npm audit)",
      "Bash(basename *)",
      "Bash(git branch)",
      "Bash(git diff *)",
      "Bash(git grep *)",
      "Bash(git show *)",
      "Bash(npm view *)",
      "Bash(pip list *)",
      "Bash(pip show *)",
      "Bash(realpath *)",
      "Bash(xargs ls *)",
      "Bash(gh search *)",
      "Bash(git blame *)",
      "Bash(git fetch *)",
      "Bash(gh --version)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(git reflog *)",
      "Bash(git status *)",
      "Bash(pip freeze *)",
      "Bash(xargs grep *)",
      "Bash(dotnet --info)",
      "Bash(dotnet list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git --version)",
      "Bash(git branch -a)",
      "Bash(git ls-tree *)",
      "Bash(git remote -v)",
      "Bash(npm --version)",
      "Bash(npx --version)",
      "Bash(pip --version)",
      "Bash(alembic show *)",
      "Bash(dotnet build *)",
      "Bash(dotnet clean *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(git describe *)",
      "Bash(git ls-files *)",
      "Bash(git shortlog *)",
      "Bash(git show-ref *)",
      "Bash(mypy --version)",
      "Bash(node --check *)",
      "Bash(node --version)",
      "Bash(npm outdated *)",
      "Bash(ruff --version)",
      "Bash(alembic heads *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh label list *)",
      "Bash(git rev-parse *)",
      "Bash(graphify path *)",
      "Bash(dotnet --version)",
      "Bash(dotnet restore *)",
      "Bash(gh auth status *)",
      "Bash(graphify query *)",
      "Bash(pytest --version)",
      "Bash(python --version)",
      "Bash(alembic --version)",
      "Bash(alembic current *)",
      "Bash(alembic history *)",
      "Bash(gh issue status *)",
      "Bash(git config --list)",
      "Bash(graphify update *)",
      "Bash(python3 --version)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet tool list *)",
      "Bash(git config --get *)",
      "Bash(graphify explain *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(git branch --list *)",
      "Bash(graphify diagnose *)",
      "Bash(git remote get-url *)",
      "Bash(git --no-pager diff *)",
      "Bash(dotnet --list-runtimes)",
      "Bash(python -m py_compile *)",
      "Bash(python3 -m py_compile *)",
      "Bash(dotnet format whitespace)",
      "Bash(dotnet nuget locals * --list)",
      "Bash(dotnet format --verify-no-changes *)",
      "Bash(bash ~/.claude/skills/release/collect.sh:*)",
      "Bash(dotnet build * | Select-String * | Select-Object *)",
      "WebFetch(domain:tunit.dev)",
      "WebFetch(domain:primeng.org)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "mcp__claude_ai_Microsoft_Learn__microsoft_docs_fetch",
      "mcp__claude_ai_Microsoft_Learn__microsoft_docs_search"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.token)",
      "Read(**/*.secrets)",
      "Read(!**/*.example)",
      "Read(!**/.*.example)",
      "Agent(model:opus)",
      "PowerShell"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/prune.sh",
            "timeout": 30,
            "async": true
          },
          {
            "type": "command",
            "command": "bash ~/.claude/sync.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/graphify-nudge.sh session",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/webfetch-allowlist.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/strip-redundant-cd.cjs",
            "if": "Bash(cd *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/graphify-nudge.sh bash"
          }
        ]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/graphify-nudge.sh search"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "outputStyle": "Concise",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "autoContinueAtUsageLimit": true,
  "terminalProgressBarEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "feedbackDrafts": "off",
  "skillOverrides": {
    "changelog-review": "user-invocable-only",
    "release": "user-invocable-only"
  }
}
