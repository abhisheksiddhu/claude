# ~/.claude sync surface — blacklist style: track config, ignore runtime/secrets.
# New config files appear in `git status` for review; add junk here as it shows up.

# secrets
.credentials.json
*.pem
*.key
*.token
.env
.env.*

# machine-local overrides (never shared)
settings.local.json
CLAUDE.local.md
.no-sync

# session state / runtime / caches (all regenerable)
projects/
file-history/
*-cache/
cache/
sessions/
session-env/
tasks/
jobs/
plans/
backups/
ide/
downloads/
plugins/
statsig/
logs/
paste-cache
daemon*
history.jsonl
stats-cache.json
.thinking-cache/
.prune-stamp
.sync-stamp
.last-*
shell-snapshots
telemetry
skills/synced
state
debug
.DS_Store
mcp-needs-auth-cache.json
skills/.trash
uploads

# injected by Claude Code cloud sessions
environment-manager/
launcher-settings.json
posttooluse-hearth-status-nudge.py
session-start-setup-script-failure.sh
stop-hook-git-check.sh
stop-hook-reply-gate.py
user-prompt-submit-reply-reminder.py
skills/session-start-hook/
bridge-spawn
